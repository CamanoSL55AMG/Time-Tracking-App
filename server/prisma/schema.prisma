generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Every table carries companyId. One company per install today; a shared
// install later needs no schema change.

model Company {
  id                       String   @id @default(uuid())
  name                     String
  timezone                 String   @default("America/Los_Angeles")
  shopLat                  Float?
  shopLng                  Float?
  shopRadiusM              Int      @default(150)
  // First day of the timesheet week, 0 = Sunday … 6 = Saturday. Monday until the
  // pay period is settled with payroll.
  weekStartDay             Int      @default(1)
  // Service call billing (Morgan Sound default). Payroll always uses the real
  // punched time; these only shape what the customer is invoiced.
  serviceTravelHours       Float    @default(0.5) // travel billed to each call, whatever the real drive
  serviceIncludedHours     Float    @default(1) // on-site time covered by the trip charge
  serviceIncrementMinutes  Int      @default(15) // on-site time past that is billed in these steps
  // Mileage reimbursement per mile. IRS business rate for 2026 is $0.725. The rate in
  // force is copied onto each mileage line, so a later change leaves old lines alone.
  mileageRate              Float    @default(0.725)
  // Expense lines paid with the employee's own money post here instead of their
  // category's account (Morgan Sound: 6-1140 Employee Business Expense). Mileage keeps
  // its category's account. Null = not set yet (the seed fills it); "" = off.
  reimbursementAccountCode String?
  // Payroll export: hours past this many in one workweek (weekStartDay, Mon-Sun at
  // Morgan Sound) go out as overtime. Washington counts overtime by the week only,
  // not by the day. 0 = no overtime split (every hour goes out as regular).
  overtimeWeeklyHours      Float @default(40)
  // Bench Repair mode is a plain clock in / clock out onto the BENCH job (Zach's team,
  // 2026-11-02). Off = the full version: pick the SD repair ticket and a task, with
  // the hours going to that ticket's SD invoice in AV Inventory.
  benchClockOnly           Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  people            Person[]
  jobs              Job[]
  phases            Phase[]
  punches           Punch[]
  apiKeys           ApiKey[]
  timesheets        Timesheet[]
  expenses          Expense[]
  expenseCategories ExpenseCategory[]
  recurringExpenses RecurringExpense[]
}

model Person {
  id           String   @id @default(uuid())
  companyId    String
  email        String   @unique
  name         String
  initials     String   @default("")
  role         String   @default("tech") // tech | lead | manager | payroll | admin
  passwordHash String?
  // Set when an admin creates the person with a password or sets a new one for them.
  // While true, a signed-in session can only read /auth/me and change its own
  // password (auth/middleware.ts passwordChangeGate). Cleared by that change.
  mustChangePassword Boolean @default(false)
  // "Forgot password?" (auth/passwordReset.ts): only the SHA-256 of the emailed one-time
  // token is kept. Cleared when the link is used; the link expires at resetExpiresAt.
  // resetSentAt holds back a second email to the same address for a few minutes.
  resetTokenHash String?   @unique
  resetExpiresAt DateTime?
  resetSentAt    DateTime?
  active       Boolean  @default(true)
  // Salaried / exempt: the payroll export sends all of their hours as regular.
  overtimeExempt Boolean @default(false)
  // How the person is paid (CONTRACTORS_ENABLED): employee = W-2 (payroll, overtime,
  // leave); contractor = 1099 (paid as a vendor in AIC Accounting: no withholding, no
  // overtime split, no leave accrual). workerTypeFrom (YYYY-MM-DD, company time) is the
  // day the current type started; days before it count as priorWorkerType. Null = always.
  workerType      String  @default("employee") // employee | contractor
  workerTypeFrom  String?
  priorWorkerType String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id])
  punches     Punch[]
  assignments Assignment[]
  timesheets  Timesheet[]
  expenses    Expense[]
  recurringExpenses RecurringExpense[]
  workItems   WorkItem[]
  jobsAdded   Job[]        @relation("JobAddedBy")
  termsAcceptances TermsAcceptance[]

  @@index([companyId, active])
}

model Job {
  id           String    @id @default(uuid())
  companyId    String
  kind         String    @default("project") // project | service | visit (pre-sale site visit, not billed) | shop | repair (an SD bench-repair ticket from AV Inventory) | other (office, incl. the OVERHEAD job)
  name         String
  code         String    @default("") // P-number, service ticket, etc.
  active       Boolean   @default(true)
  // Jetbuilt stage (PROPOSAL, CONTRACT, INSTALL, REVIEW…), sent across by GED. Empty
  // for jobs added here. Used with recent punches to fold old projects under Archived.
  stage        String    @default("")
  siteLat      Float?
  siteLng      Float?
  siteRadiusM  Int?
  siteAddress  String    @default("") // street address of the job site, for directions
  // The client and who to call there. Required when a tech adds a client in the field.
  clientName   String    @default("")
  contactName  String    @default("")
  contactPhone String    @default("")
  contactEmail String    @default("")
  // A tech added this client from the punch screen (Service Call or Site Visit); the
  // office checks it and sets reviewedAt. Null for jobs from Jetbuilt/GED or Manage.
  addedById    String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company     Company      @relation(fields: [companyId], references: [id])
  punches     Punch[]
  assignments Assignment[]
  expenses    Expense[]
  recurringExpenses RecurringExpense[]
  workItems   WorkItem[]
  addedBy     Person?      @relation("JobAddedBy", fields: [addedById], references: [id])

  @@index([companyId, active])
}

// The task picker: the phases of a work day, in order.
model Phase {
  id            String  @id @default(uuid())
  companyId     String
  key           String // stable slug, e.g. "travel-out"
  name          String
  short         String
  sortOrder     Int
  atShop        Boolean @default(false)
  active        Boolean @default(true)
  // The sold-labor line this phase's hours roll up to, so hours line up with the
  // labor budget in Jetbuilt: engineering | install | programming | management | other.
  laborCategory String  @default("install")
  // Part of the field day's step-by-step sequence ("Next" and the step track).
  // Office phases (engineering, programming, PM) are picked directly instead.
  dayFlow       Boolean @default(true)
  // The work mode the phase is offered in: install | service | office | shop.
  // "Next" walks the field-day steps of one mode only.
  mode          String  @default("install")

  company Company @relation(fields: [companyId], references: [id])
  punches Punch[]

  @@unique([companyId, key])
  @@index([companyId, sortOrder])
}

// One segment of work. Open segment (clockOut null) = on the clock.
// Switching job or phase closes the open segment and opens a new one.
model Punch {
  id           String    @id @default(uuid())
  companyId    String
  personId     String
  jobId        String
  phaseId      String?
  clockIn      DateTime
  clockOut     DateTime?
  source       String    @default("app") // app | api | lead | edit
  inLat        Float?
  inLng        Float?
  inAccuracyM  Float?
  outLat       Float?
  outLng       Float?
  outAccuracyM Float?
  notes        String    @default("")
  clientId     String? // generated on the phone; makes offline re-sends harmless
  apiKeyId     String? // set when an integration punched on the person's behalf
  punchedById  String? // the crew lead, when a lead punched for this person
  workItemId   String? // the open item (service ticket, shop / office / CAD task) this time belongs to
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company  Company     @relation(fields: [companyId], references: [id])
  person   Person      @relation(fields: [personId], references: [id])
  job      Job         @relation(fields: [jobId], references: [id])
  phase    Phase?      @relation(fields: [phaseId], references: [id])
  workItem WorkItem?   @relation(fields: [workItemId], references: [id])
  edits    PunchEdit[]

  @@unique([companyId, clientId])
  @@index([personId, clockIn])
  @@index([companyId, clockIn])
  @@index([companyId, clockOut])
  @@index([jobId])
  @@index([companyId, updatedAt])
}

// Who is scheduled on which job on a given day. Pushed in by GED from the shared
// job calendar; pre-selects the job when a tech clocks in. A push for a date
// replaces that date's rows from the same source.
model Assignment {
  id         String   @id @default(uuid())
  companyId  String
  date       String // YYYY-MM-DD in the company timezone
  personId   String
  jobId      String? // null when the calendar entry names no job we know
  title      String   @default("") // the calendar entry as written
  shopTime   String   @default("") // call time, e.g. "7am"
  source     String   @default("api")
  externalId String   @default("") // e.g. the calendar event id
  createdAt  DateTime @default(now())

  person Person @relation(fields: [personId], references: [id])
  job    Job?   @relation(fields: [jobId], references: [id])

  @@index([companyId, date])
  @@index([personId, date])
}

// Audit trail: every correction keeps who, when, before, after and why.
model PunchEdit {
  id            String   @id @default(uuid())
  punchId       String
  editedById    String?
  editedByKeyId String?
  at            DateTime @default(now())
  before        Json
  after         Json
  reason        String
  // The person fixed their own time (no approval first, Art 2026-11-09). It shows as
  // edited until a supervisor or admin has looked it over.
  selfEdit      Boolean   @default(false)
  reviewedById  String?
  reviewedAt    DateTime?

  punch Punch @relation(fields: [punchId], references: [id])

  @@index([punchId])
  @@index([selfEdit, reviewedAt])
}

// One person's week: the tech signs it, a manager or payroll approves it. An
// approved week is locked: punches and corrections inside it are refused until an
// approver reopens it. A change inside a signed week sends it back for signing.
model Timesheet {
  id           String    @id @default(uuid())
  companyId    String
  personId     String
  weekStart    String // YYYY-MM-DD, local date of the week's first day
  status       String    @default("open") // open | signed | approved
  hours        Float     @default(0) // total when last signed or approved
  signedAt     DateTime?
  signedById   String?
  approvedAt   DateTime?
  approvedById String?
  // Last day (YYYY-MM-DD) the approval covers. Approvers can sign off any time, so a
  // week can be approved through the 15th or month end before it is over; the days
  // after it stay open. Null on an approved week means the whole week.
  approvedThrough String?
  note         String    @default("") // why it was reopened, or the approver's note
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  person  Person  @relation(fields: [personId], references: [id])

  @@unique([personId, weekStart])
  @@index([companyId, weekStart])
}

// A person asks for their own time to be changed: a segment's times, job, phase
// or note, or a missing segment added. Nothing changes until a supervisor approves;
// the approved change is applied as an audited correction.
model ChangeRequest {
  id            String    @id @default(uuid())
  companyId     String
  personId      String // whose time
  requestedById String
  kind          String // edit | add
  punchId       String? // the segment to change (edit)
  weekStart     String // week the change falls in; a pending request holds up approving that week
  clockIn       DateTime? // requested values; null = leave as it is
  clockOut      DateTime?
  jobId         String?
  phaseId       String?
  notes         String?
  reason        String
  before        Json? // the segment when the request was made
  status        String    @default("pending") // pending | approved | rejected | withdrawn
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String    @default("")
  resultPunchId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId, status])
  @@index([personId, createdAt])
  @@index([personId, weekStart, status])
}

// Ids in other systems (ged, jetbuilt, timesheets, accountedge) pointing at our rows.
model ExternalRef {
  id         String   @id @default(uuid())
  companyId  String
  entity     String // job | person
  entityId   String
  system     String
  externalId String
  createdAt  DateTime @default(now())

  @@unique([companyId, entity, system, externalId])
  @@index([entity, entityId])
}

model ApiKey {
  id          String    @id @default(uuid())
  companyId   String
  name        String
  prefix      String // first characters, shown in lists so a key can be recognised
  keyHash     String    @unique // sha-256 of the key; the key itself is never stored
  scopes      String[]
  createdById String?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

// Ordered change feed. Apps that cannot receive webhooks poll /events?after=seq.
model Event {
  seq       Int      @id @default(autoincrement())
  companyId String
  type      String
  payload   Json
  at        DateTime @default(now())

  @@index([companyId, seq])
}

// A repeated POST with the same Idempotency-Key returns the first result.
model IdempotencyKey {
  id        String   @id @default(uuid())
  companyId String
  key       String
  method    String
  path      String
  status    Int
  response  Json
  createdAt DateTime @default(now())

  @@unique([companyId, key])
}

// First sign-in terms (legal/manifest.json): one row each time a person accepts one
// version of one document. Append-only: the app never updates or deletes these rows.
model TermsAcceptance {
  id            String   @id @default(uuid())
  companyId     String
  userId        String // the person who accepted
  documentId    String // e.g. logbook-eula, aic-platform-terms
  version       String
  contentSha256 String // sha256 hex of the exact file they were shown
  acceptedAt    DateTime @default(now())
  ip            String   @default("")
  userAgent     String   @default("")

  person Person @relation(fields: [userId], references: [id])

  @@unique([userId, documentId, version])
  @@index([companyId, userId])
  @@map("terms_acceptance")
}

// One-click sign-in tokens from GED are single use.
model SsoNonce {
  jti    String   @id
  usedAt DateTime @default(now())
}

// ─── Open items ──────────────────────────────────────────────────────────────

// A service ticket (Service mode) or a task (Shop, Office, CAD) a person has open on
// one job. Opened by the first punch on that job in that mode; every later segment on
// the same job and mode joins it, so switching away pauses it rather than closing
// it. Closed by the person with a resolution note, usually at the end of the day; an
// item left open carries a reason and shows up again the next day.
model WorkItem {
  id            String    @id @default(uuid())
  companyId     String
  personId      String
  jobId         String
  mode          String // service | shop | office | cad
  notes         String    @default("") // what it is about: the notes given when punching on it
  status        String    @default("open") // open | closed
  waitingReason String    @default("") // why it was left open at the end of a day
  resolution    String    @default("") // what was done, given when closing it
  openedAt      DateTime
  lastWorkedAt  DateTime
  closedAt      DateTime?
  closedById    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  person  Person  @relation(fields: [personId], references: [id])
  job     Job     @relation(fields: [jobId], references: [id])
  punches Punch[]

  @@index([personId, status])
  @@index([companyId, status])
  @@index([jobId])
}

// ─── Expenses ────────────────────────────────────────────────────────────────

// What an expense is for: Materials, Fuel, Meals, Parking, Mileage… kind "mileage"
// lines are entered as miles and priced at the company's mileage rate.
model ExpenseCategory {
  id          String  @id @default(uuid())
  companyId   String
  name        String
  kind        String  @default("expense") // expense | mileage
  accountCode String  @default("") // the accounting account it posts to
  sortOrder   Int     @default(0)
  active      Boolean @default(true)

  company   Company            @relation(fields: [companyId], references: [id])
  expenses  Expense[]
  recurring RecurringExpense[]

  @@unique([companyId, name])
}

// One expense or mileage line. Charged to a job (the person's current flight, or
// one they pick) or to nothing (general overhead). Submitted when added; a manager
// or payroll approves or rejects it. Rejected lines can be fixed and go back in.
model Expense {
  id           String    @id @default(uuid())
  companyId    String
  personId     String
  jobId        String?
  punchId      String? // the segment that was the current flight when it was added
  date         String // YYYY-MM-DD, company time
  categoryId   String
  amountCents  Int // what is claimed; for mileage, miles × rate
  miles        Float?
  ratePerMile  Float?
  paidBy       String    @default("employee") // employee (reimburse) | company_card
  vendor       String    @default("")
  notes        String    @default("")
  receiptPath  String? // file under server/uploads/receipts
  receiptType  String?
  status       String    @default("submitted") // draft | submitted | approved | rejected
  submittedAt  DateTime?
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String    @default("")
  clientId     String? // generated on the phone; a re-send does not add it twice
  // Made by a monthly repeat (RecurringExpense). RecurringExpenseRun keeps which
  // month it was for, so a restart or a second run never adds a month twice.
  recurringExpenseId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company   Company           @relation(fields: [companyId], references: [id])
  person    Person            @relation(fields: [personId], references: [id])
  job       Job?              @relation(fields: [jobId], references: [id])
  category  ExpenseCategory   @relation(fields: [categoryId], references: [id])
  recurring RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)

  @@unique([companyId, clientId])
  @@index([companyId, status])
  @@index([personId, date])
  @@index([jobId])
}

// A monthly repeat: a bill a person pays every month (a phone plan, say). Once a
// month, on its day, it adds a normal submitted Expense line that goes through the
// usual approval. Pausing skips the months it is paused; stopping is for good.
model RecurringExpense {
  id          String   @id @default(uuid())
  companyId   String
  personId    String
  categoryId  String
  jobId       String?
  amountCents Int
  paidBy      String   @default("employee") // employee (reimburse) | company_card
  vendor      String   @default("")
  notes       String   @default("")
  dayOfMonth  Int // 1-31; a short month uses its last day
  startMonth  String // YYYY-MM, the first month a line can be made (moved up on resume)
  endMonth    String? // YYYY-MM, the last month; null = until stopped
  status      String   @default("active") // active | paused | stopped
  lastMonth   String? // YYYY-MM of the last line made (for show; the runs table is the record)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company         @relation(fields: [companyId], references: [id])
  person   Person          @relation(fields: [personId], references: [id])
  job      Job?            @relation(fields: [jobId], references: [id])
  category ExpenseCategory @relation(fields: [categoryId], references: [id])
  expenses Expense[]
  runs     RecurringExpenseRun[]

  @@index([companyId, status])
  @@index([personId])
}

// One row per repeat per month that has been made. Its key is what makes the monthly
// run safe to repeat: a second insert for the same month fails, and the month is
// never made again, even if its line was later removed.
model RecurringExpenseRun {
  recurringExpenseId String
  month              String // YYYY-MM
  expenseId          String? // the line it made (it may since have been removed)
  createdAt          DateTime @default(now())

  recurring RecurringExpense @relation(fields: [recurringExpenseId], references: [id], onDelete: Cascade)

  @@id([recurringExpenseId, month])
}

// ─── Leave (Phase 5, TIME-TRACKING-APP.md §7) ───────────────────────────────
// Off unless LEAVE_ENABLED=true. Kept in tables of their own, linked by id, so the
// rest of the schema doesn't change.

// Company-wide leave settings. One row per company, made on first use.
model LeaveSettings {
  companyId              String   @id
  // separate = sick leave and vacation are different banks (Morgan Sound);
  // combined = one PTO bank that has to meet every Washington sick-leave rule.
  banks                  String   @default("separate")
  // Pay the sick balance at separation (WA construction-industry rule). Does not
  // apply to Morgan Sound; off by default.
  sickPayoutAtSeparation Boolean  @default(false)
  // The day Logbook took over the balances (opening balances are dated this day).
  // Accrual counts only hours worked on or after it, so nothing is earned twice.
  switchoverDate         String?
  updatedAt              DateTime @updatedAt
}

// What leave needs to know about a person beyond the roster.
model LeaveProfile {
  personId    String    @id
  companyId   String
  hireDate    String? // YYYY-MM-DD; drives the 90-day wait and years-of-service tiers
  noticeAckAt DateTime? // when they acknowledged the written notice of sick-leave rights
  updatedAt   DateTime  @updatedAt

  @@index([companyId])
}

// Kinds of leave: sick, vacation (or one PTO bank), WA family leave, holiday, unpaid…
model LeaveType {
  id           String   @id @default(uuid())
  companyId    String
  key          String // stable slug: sick | vacation | pto | wa_pfml | holiday | unpaid …
  name         String
  paid         Boolean  @default(true) // paid by the company: goes into the payroll export
  drawsBalance Boolean  @default(true) // requests take hours off a balance
  statutory    String   @default("none") // wa_sick | wa_pfml | none
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([companyId, key])
}

// How a leave type is earned. A person gets a policy per leave type (PersonLeavePolicy).
model LeavePolicy {
  id           String   @id @default(uuid())
  companyId    String
  leaveTypeId  String
  name         String
  // per_hours_worked: rateHours for every perHours worked (all hours: overtime and travel too)
  // per_period: periodHours each pay period
  // annual_grant: periodHours on Jan 1 (grantOn jan1) or the work anniversary (grantOn anniversary)
  // none: nothing is earned (holiday, unpaid, family leave)
  method       String   @default("per_hours_worked")
  rateHours    Float    @default(1)
  perHours     Float    @default(40)
  periodHours  Float    @default(0)
  grantOn      String   @default("jan1")
  // Years-of-service steps: [{ "years": 5, "rateHours": 1.5 }] or [{ "years": 5, "periodHours": 6 }]
  tiers        Json     @default("[]")
  balanceCap   Float? // accrual stops at this balance; null = no cap
  carryoverMax Float? // balance kept past Dec 31; null = all of it
  waitingDays  Int      @default(0) // usable from this many days after the hire date
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId, leaveTypeId])
}

model PersonLeavePolicy {
  id            String   @id @default(uuid())
  companyId     String
  personId      String
  leaveTypeId   String
  leavePolicyId String
  effectiveFrom String // YYYY-MM-DD
  effectiveTo   String? // YYYY-MM-DD inclusive; null = still in force
  createdAt     DateTime @default(now())

  @@index([personId, leaveTypeId])
  @@index([companyId])
}

// Every change to a balance is a row; a balance is the sum. Never updated or deleted.
model LeaveLedger {
  id          String   @id @default(uuid())
  companyId   String
  personId    String
  leaveTypeId String
  kind        String // accrual | use | adjustment | carryover | forfeit | payout | reinstate
  hours       Float // + adds to the balance, - takes away
  date        String // YYYY-MM-DD the entry counts on (company time)
  // Where it came from: accrual:<policy>:<from>:<to>, grant:<policy>:<date>,
  // request:<id>, request:<id>:cancel, import:<date>, year-end:<year>:<policy>, manual
  sourceRef   String   @default("manual")
  note        String   @default("")
  createdById String?
  createdAt   DateTime @default(now())

  @@index([personId, leaveTypeId, date])
  @@index([companyId, date])
  @@index([companyId, sourceRef])
}

// Time off asked for (or recorded by a supervisor, e.g. a state family-leave period).
// No reason is stored: sick leave is just "sick leave", with no medical detail.
model LeaveRequest {
  id            String    @id @default(uuid())
  companyId     String
  personId      String
  leaveTypeId   String
  startDate     String // YYYY-MM-DD
  endDate       String // YYYY-MM-DD inclusive
  days          Json // [{ "date": "YYYY-MM-DD", "hours": 8 }]
  hours         Float
  note          String    @default("") // scheduling note only; never kept for sick leave
  status        String    @default("pending") // pending | approved | denied | cancelled
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId, status])
  @@index([personId, startDate])
  @@index([companyId, startDate])
}
