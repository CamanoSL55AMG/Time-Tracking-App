generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Every table carries companyId. One company per install today; a shared
// install later needs no schema change.

model Company {
  id          String   @id @default(uuid())
  name        String
  timezone    String   @default("America/Los_Angeles")
  shopLat     Float?
  shopLng     Float?
  shopRadiusM Int      @default(150)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  people  Person[]
  jobs    Job[]
  phases  Phase[]
  punches Punch[]
  apiKeys ApiKey[]
}

model Person {
  id           String   @id @default(uuid())
  companyId    String
  email        String   @unique
  name         String
  initials     String   @default("")
  role         String   @default("tech") // tech | lead | manager | payroll | admin
  passwordHash String?
  active       Boolean  @default(true)
  // First day of work, YYYY-MM-DD. Sets when sick leave becomes usable (day 90),
  // years-of-service tiers and anniversary grants.
  hireDate        String?
  // When the person acknowledged the written notice of their sick-leave rights.
  sickNoticeAckAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company       Company             @relation(fields: [companyId], references: [id])
  punches       Punch[]
  assignments   Assignment[]
  expenses      Expense[]
  leaveRequests LeaveRequest[]
  leavePolicies PersonLeavePolicy[]
  leaveLedger   LeaveLedger[]

  @@index([companyId, active])
}

model Job {
  id          String   @id @default(uuid())
  companyId   String
  kind        String   @default("project") // project | service | shop | other
  name        String
  code        String   @default("") // P-number, service ticket, etc.
  active      Boolean  @default(true)
  siteLat     Float?
  siteLng     Float?
  siteRadiusM Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id])
  punches     Punch[]
  assignments Assignment[]
  expenses    Expense[]

  @@index([companyId, active])
}

// The task picker: the phases of a work day, in order.
model Phase {
  id        String  @id @default(uuid())
  companyId String
  key       String // stable slug, e.g. "travel-out"
  name      String
  short     String
  sortOrder Int
  atShop    Boolean @default(false)
  active    Boolean @default(true)
  // The sold-labor line this phase's hours roll up to, so hours line up with the
  // labor budget in Jetbuilt: engineering | install | programming | management | other.
  laborCategory String  @default("install")
  // Part of the field day's step-by-step sequence ("Next" and the step track).
  // Office phases (engineering, programming, PM) are picked directly instead.
  dayFlow       Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id])
  punches Punch[]

  @@unique([companyId, key])
  @@index([companyId, sortOrder])
}

// One segment of work. Open segment (clockOut null) = on the clock.
// Switching job or phase closes the open segment and opens a new one.
model Punch {
  id           String    @id @default(uuid())
  companyId    String
  personId     String
  jobId        String
  phaseId      String?
  clockIn      DateTime
  clockOut     DateTime?
  source       String    @default("app") // app | api | lead | edit
  inLat        Float?
  inLng        Float?
  inAccuracyM  Float?
  outLat       Float?
  outLng       Float?
  outAccuracyM Float?
  notes        String    @default("")
  clientId     String? // generated on the phone; makes offline re-sends harmless
  apiKeyId     String? // set when an integration punched on the person's behalf
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company Company     @relation(fields: [companyId], references: [id])
  person  Person      @relation(fields: [personId], references: [id])
  job     Job         @relation(fields: [jobId], references: [id])
  phase   Phase?      @relation(fields: [phaseId], references: [id])
  edits   PunchEdit[]

  @@unique([companyId, clientId])
  @@index([personId, clockIn])
  @@index([companyId, clockIn])
  @@index([companyId, clockOut])
  @@index([jobId])
  @@index([companyId, updatedAt])
}

// Who is scheduled on which job on a given day. Pushed in by GED from the shared
// job calendar; pre-selects the job when a tech clocks in. A push for a date
// replaces that date's rows from the same source.
model Assignment {
  id         String   @id @default(uuid())
  companyId  String
  date       String // YYYY-MM-DD in the company timezone
  personId   String
  jobId      String? // null when the calendar entry names no job we know
  title      String   @default("") // the calendar entry as written
  shopTime   String   @default("") // call time, e.g. "7am"
  source     String   @default("api")
  externalId String   @default("") // e.g. the calendar event id
  createdAt  DateTime @default(now())

  person Person @relation(fields: [personId], references: [id])
  job    Job?   @relation(fields: [jobId], references: [id])

  @@index([companyId, date])
  @@index([personId, date])
}

// Audit trail: every correction keeps who, when, before, after and why.
model PunchEdit {
  id            String   @id @default(uuid())
  punchId       String
  editedById    String?
  editedByKeyId String?
  at            DateTime @default(now())
  before        Json
  after         Json
  reason        String

  punch Punch @relation(fields: [punchId], references: [id])

  @@index([punchId])
}

// Ids in other systems (ged, jetbuilt, timesheets, accountedge) pointing at our rows.
model ExternalRef {
  id         String   @id @default(uuid())
  companyId  String
  entity     String // job | person
  entityId   String
  system     String
  externalId String
  createdAt  DateTime @default(now())

  @@unique([companyId, entity, system, externalId])
  @@index([entity, entityId])
}

model ApiKey {
  id          String    @id @default(uuid())
  companyId   String
  name        String
  prefix      String // first characters, shown in lists so a key can be recognised
  keyHash     String    @unique // sha-256 of the key; the key itself is never stored
  scopes      String[]
  createdById String?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

// Ordered change feed. Apps that cannot receive webhooks poll /events?after=seq.
model Event {
  seq       Int      @id @default(autoincrement())
  companyId String
  type      String
  payload   Json
  at        DateTime @default(now())

  @@index([companyId, seq])
}

// A repeated POST with the same Idempotency-Key returns the first result.
model IdempotencyKey {
  id        String   @id @default(uuid())
  companyId String
  key       String
  method    String
  path      String
  status    Int
  response  Json
  createdAt DateTime @default(now())

  @@unique([companyId, key])
}

// One-click sign-in tokens from GED are single use.
model SsoNonce {
  jti    String   @id
  usedAt DateTime @default(now())
}

// ─── Expenses and mileage ───────────────────────────────────────────────────
// Money is whole cents. A mileage line's amount is miles × the rate in force on
// its date, worked out when the line is saved and kept, so a later rate change
// never rewrites an old claim.

model ExpenseCategory {
  id          String  @id @default(uuid())
  companyId   String
  name        String
  accountCode String  @default("") // where accounting posts it; filled in by finance
  mileage     Boolean @default(false) // lines in this category are miles × rate
  sortOrder   Int     @default(0)
  active      Boolean @default(true)

  expenses Expense[]

  @@unique([companyId, name])
  @@index([companyId, sortOrder])
}

model MileageRate {
  id            String   @id @default(uuid())
  companyId     String
  effectiveFrom String // YYYY-MM-DD; the rate applies from this date until the next one
  rateMills     Int // tenths of a cent per mile: 725 = 72.5¢
  note          String   @default("")
  createdAt     DateTime @default(now())

  @@unique([companyId, effectiveFrom])
}

model ExpenseReport {
  id           String    @id @default(uuid())
  companyId    String
  personId     String
  title        String    @default("")
  status       String    @default("draft") // draft | submitted | approved | rejected | exported
  submittedAt  DateTime?
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String    @default("")
  exportedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  expenses Expense[]

  @@index([companyId, status])
  @@index([personId])
}

model Expense {
  id          String   @id @default(uuid())
  companyId   String
  personId    String
  reportId    String?
  jobId       String?
  categoryId  String
  date        String // YYYY-MM-DD the money was spent or the trip was made
  amountCents Int
  miles       Float?
  rateMills   Int? // the mileage rate used, kept with the line
  paidBy      String   @default("employee") // employee (reimburse) | company (company card)
  vendor      String   @default("")
  notes       String   @default("")
  clientId    String? // generated on the phone; makes re-sends harmless
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  person   Person          @relation(fields: [personId], references: [id])
  job      Job?            @relation(fields: [jobId], references: [id])
  category ExpenseCategory @relation(fields: [categoryId], references: [id])
  report   ExpenseReport?  @relation(fields: [reportId], references: [id])
  receipt  Receipt?

  @@unique([companyId, clientId])
  @@index([companyId, date])
  @@index([personId, date])
  @@index([reportId])
  @@index([jobId])
}

// Receipt photo or PDF, kept in the database so it is backed up with the record.
model Receipt {
  id        String   @id @default(uuid())
  companyId String
  expenseId String   @unique
  mimeType  String
  bytes     Int
  data      Bytes
  createdAt DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}

// ─── Leave ──────────────────────────────────────────────────────────────────
// A balance is never stored. It is the sum of LeaveLedger rows, so every balance
// can be explained line by line.

model LeaveType {
  id           String  @id @default(uuid())
  companyId    String
  key          String // stable slug, e.g. "sick", "vacation"
  name         String
  paid         Boolean @default(true)
  drawsBalance Boolean @default(true) // false: holiday, jury duty, unpaid…
  statutory    String  @default("none") // wa_sick | wa_pfml | none
  sortOrder    Int     @default(0)
  active       Boolean @default(true)

  policies PersonLeavePolicy[]
  ledger   LeaveLedger[]
  requests LeaveRequest[]
  rules    LeavePolicy[]

  @@unique([companyId, key])
}

model LeavePolicy {
  id           String  @id @default(uuid())
  companyId    String
  leaveTypeId  String
  name         String
  // per_hours_worked: rateHours for every perHours worked (WA sick: 1 per 40)
  // per_month:        rateHours each calendar month
  // annual_grant:     rateHours once a year, on 1 January or the work anniversary
  method       String  @default("per_hours_worked")
  rateHours    Float
  perHours     Float   @default(40)
  grantOn      String  @default("calendar") // annual_grant: calendar | anniversary
  capHours     Float? // accrual stops while the balance is at or above this
  carryoverMax Float? // at year end, hours above this are forfeited
  waitingDays  Int     @default(0) // usable from this many calendar days after hireDate
  // Years-of-service steps: [{ "afterYears": 3, "rateHours": 1.5 }]
  tiers        Json    @default("[]")
  // Applies to every active person without being assigned (the WA sick preset).
  appliesToAll Boolean @default(false)
  active       Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leaveType LeaveType           @relation(fields: [leaveTypeId], references: [id])
  people    PersonLeavePolicy[]

  @@index([companyId])
}

model PersonLeavePolicy {
  id            String  @id @default(uuid())
  companyId     String
  personId      String
  leavePolicyId String
  leaveTypeId   String
  effectiveFrom String // YYYY-MM-DD
  effectiveTo   String? // YYYY-MM-DD, inclusive; null = still in force

  person    Person      @relation(fields: [personId], references: [id])
  policy    LeavePolicy @relation(fields: [leavePolicyId], references: [id])
  leaveType LeaveType   @relation(fields: [leaveTypeId], references: [id])

  @@index([personId])
}

model LeaveLedger {
  id          String   @id @default(uuid())
  companyId   String
  personId    String
  leaveTypeId String
  // accrual | use | adjustment | carryover | forfeit | payout | reinstate
  kind        String
  hours       Float // positive adds to the balance, negative takes from it
  date        String // YYYY-MM-DD the change counts on
  // What caused it. Unique per person and type, so re-running an accrual or
  // approving twice cannot double-count: accrual:<policy>:<week>, request:<id>…
  sourceRef   String
  note        String   @default("")
  createdById String?
  createdAt   DateTime @default(now())

  person    Person    @relation(fields: [personId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([companyId, personId, leaveTypeId, sourceRef])
  @@index([personId, leaveTypeId, date])
  @@index([companyId, date])
}

model LeaveRequest {
  id           String    @id @default(uuid())
  companyId    String
  personId     String
  leaveTypeId  String
  startDate    String // YYYY-MM-DD
  endDate      String // YYYY-MM-DD, inclusive
  hours        Float
  // Free text from the person. Never a medical reason; the app does not ask for one.
  note         String    @default("")
  status       String    @default("requested") // requested | approved | denied | cancelled
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  person    Person    @relation(fields: [personId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([companyId, status])
  @@index([personId, startDate])
}
