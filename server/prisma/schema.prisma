generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Every table carries companyId. One company per install today; a shared
// install later needs no schema change.

model Company {
  id          String   @id @default(uuid())
  name        String
  timezone    String   @default("America/Los_Angeles")
  shopLat     Float?
  shopLng     Float?
  shopRadiusM Int      @default(150)
  // First day of the timesheet week, 0 = Sunday … 6 = Saturday. Monday until the
  // pay period is settled with payroll.
  weekStartDay Int     @default(1)
  // Service call billing (Morgan Sound default). Payroll always uses the real
  // punched time; these only shape what the customer is invoiced.
  serviceTravelHours       Float @default(0.5) // travel billed to each call, whatever the real drive
  serviceIncludedHours     Float @default(1) // on-site time covered by the trip charge
  serviceIncrementMinutes  Int   @default(15) // on-site time past that is billed in these steps
  // Mileage reimbursement per mile. IRS business rate for 2026 is $0.725. The rate in
  // force is copied onto each mileage line, so a later change leaves old lines alone.
  mileageRate              Float @default(0.725)
  // Expense lines paid with the employee's own money post here instead of their
  // category's account (Morgan Sound: 6-1140 Employee Business Expense). Mileage keeps
  // its category's account. Null = not set yet (the seed fills it); "" = off.
  reimbursementAccountCode String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  people  Person[]
  jobs    Job[]
  phases  Phase[]
  punches Punch[]
  apiKeys ApiKey[]
  timesheets Timesheet[]
  expenses   Expense[]
  expenseCategories ExpenseCategory[]
}

model Person {
  id           String   @id @default(uuid())
  companyId    String
  email        String   @unique
  name         String
  initials     String   @default("")
  role         String   @default("tech") // tech | lead | manager | payroll | admin
  passwordHash String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id])
  punches     Punch[]
  assignments Assignment[]
  timesheets  Timesheet[]
  expenses    Expense[]
  workItems   WorkItem[]

  @@index([companyId, active])
}

model Job {
  id          String   @id @default(uuid())
  companyId   String
  kind        String   @default("project") // project | service | shop | repair (an SD bench-repair ticket from AV Inventory) | other (office, incl. the OVERHEAD job)
  name        String
  code        String   @default("") // P-number, service ticket, etc.
  active      Boolean  @default(true)
  siteLat     Float?
  siteLng     Float?
  siteRadiusM Int?
  siteAddress String   @default("") // street address of the job site, for directions
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id])
  punches     Punch[]
  assignments Assignment[]
  expenses    Expense[]
  workItems   WorkItem[]

  @@index([companyId, active])
}

// The task picker: the phases of a work day, in order.
model Phase {
  id        String  @id @default(uuid())
  companyId String
  key       String // stable slug, e.g. "travel-out"
  name      String
  short     String
  sortOrder Int
  atShop    Boolean @default(false)
  active    Boolean @default(true)
  // The sold-labor line this phase's hours roll up to, so hours line up with the
  // labor budget in Jetbuilt: engineering | install | programming | management | other.
  laborCategory String  @default("install")
  // Part of the field day's step-by-step sequence ("Next" and the step track).
  // Office phases (engineering, programming, PM) are picked directly instead.
  dayFlow       Boolean @default(true)
  // The work mode the phase is offered in: install | service | office | shop.
  // "Next" walks the field-day steps of one mode only.
  mode          String  @default("install")

  company Company @relation(fields: [companyId], references: [id])
  punches Punch[]

  @@unique([companyId, key])
  @@index([companyId, sortOrder])
}

// One segment of work. Open segment (clockOut null) = on the clock.
// Switching job or phase closes the open segment and opens a new one.
model Punch {
  id           String    @id @default(uuid())
  companyId    String
  personId     String
  jobId        String
  phaseId      String?
  clockIn      DateTime
  clockOut     DateTime?
  source       String    @default("app") // app | api | lead | edit
  inLat        Float?
  inLng        Float?
  inAccuracyM  Float?
  outLat       Float?
  outLng       Float?
  outAccuracyM Float?
  notes        String    @default("")
  clientId     String? // generated on the phone; makes offline re-sends harmless
  apiKeyId     String? // set when an integration punched on the person's behalf
  punchedById  String? // the crew lead, when a lead punched for this person
  workItemId   String? // the open item (service ticket, shop / office / CAD task) this time belongs to
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company Company     @relation(fields: [companyId], references: [id])
  person  Person      @relation(fields: [personId], references: [id])
  job     Job         @relation(fields: [jobId], references: [id])
  phase   Phase?      @relation(fields: [phaseId], references: [id])
  workItem WorkItem?  @relation(fields: [workItemId], references: [id])
  edits   PunchEdit[]

  @@unique([companyId, clientId])
  @@index([personId, clockIn])
  @@index([companyId, clockIn])
  @@index([companyId, clockOut])
  @@index([jobId])
  @@index([companyId, updatedAt])
}

// Who is scheduled on which job on a given day. Pushed in by GED from the shared
// job calendar; pre-selects the job when a tech clocks in. A push for a date
// replaces that date's rows from the same source.
model Assignment {
  id         String   @id @default(uuid())
  companyId  String
  date       String // YYYY-MM-DD in the company timezone
  personId   String
  jobId      String? // null when the calendar entry names no job we know
  title      String   @default("") // the calendar entry as written
  shopTime   String   @default("") // call time, e.g. "7am"
  source     String   @default("api")
  externalId String   @default("") // e.g. the calendar event id
  createdAt  DateTime @default(now())

  person Person @relation(fields: [personId], references: [id])
  job    Job?   @relation(fields: [jobId], references: [id])

  @@index([companyId, date])
  @@index([personId, date])
}

// Audit trail: every correction keeps who, when, before, after and why.
model PunchEdit {
  id            String   @id @default(uuid())
  punchId       String
  editedById    String?
  editedByKeyId String?
  at            DateTime @default(now())
  before        Json
  after         Json
  reason        String

  punch Punch @relation(fields: [punchId], references: [id])

  @@index([punchId])
}

// One person's week: the tech signs it, a manager or payroll approves it. An
// approved week is locked: punches and corrections inside it are refused until an
// approver reopens it. A change inside a signed week sends it back for signing.
model Timesheet {
  id           String    @id @default(uuid())
  companyId    String
  personId     String
  weekStart    String // YYYY-MM-DD, local date of the week's first day
  status       String    @default("open") // open | signed | approved
  hours        Float     @default(0) // total when last signed or approved
  signedAt     DateTime?
  signedById   String?
  approvedAt   DateTime?
  approvedById String?
  note         String    @default("") // why it was reopened, or the approver's note
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  person  Person  @relation(fields: [personId], references: [id])

  @@unique([personId, weekStart])
  @@index([companyId, weekStart])
}

// A person asks for their own time to be changed: a segment's times, job, phase
// or note, or a missing segment added. Nothing changes until a supervisor approves;
// the approved change is applied as an audited correction.
model ChangeRequest {
  id            String    @id @default(uuid())
  companyId     String
  personId      String // whose time
  requestedById String
  kind          String // edit | add
  punchId       String? // the segment to change (edit)
  weekStart     String // week the change falls in; a pending request holds up approving that week
  clockIn       DateTime? // requested values; null = leave as it is
  clockOut      DateTime?
  jobId         String?
  phaseId       String?
  notes         String?
  reason        String
  before        Json? // the segment when the request was made
  status        String    @default("pending") // pending | approved | rejected | withdrawn
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String    @default("")
  resultPunchId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId, status])
  @@index([personId, createdAt])
  @@index([personId, weekStart, status])
}

// Ids in other systems (ged, jetbuilt, timesheets, accountedge) pointing at our rows.
model ExternalRef {
  id         String   @id @default(uuid())
  companyId  String
  entity     String // job | person
  entityId   String
  system     String
  externalId String
  createdAt  DateTime @default(now())

  @@unique([companyId, entity, system, externalId])
  @@index([entity, entityId])
}

model ApiKey {
  id          String    @id @default(uuid())
  companyId   String
  name        String
  prefix      String // first characters, shown in lists so a key can be recognised
  keyHash     String    @unique // sha-256 of the key; the key itself is never stored
  scopes      String[]
  createdById String?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

// Ordered change feed. Apps that cannot receive webhooks poll /events?after=seq.
model Event {
  seq       Int      @id @default(autoincrement())
  companyId String
  type      String
  payload   Json
  at        DateTime @default(now())

  @@index([companyId, seq])
}

// A repeated POST with the same Idempotency-Key returns the first result.
model IdempotencyKey {
  id        String   @id @default(uuid())
  companyId String
  key       String
  method    String
  path      String
  status    Int
  response  Json
  createdAt DateTime @default(now())

  @@unique([companyId, key])
}

// One-click sign-in tokens from GED are single use.
model SsoNonce {
  jti    String   @id
  usedAt DateTime @default(now())
}

// ─── Open items ──────────────────────────────────────────────────────────────

// A service ticket (Service mode) or a task (Shop, Office, CAD) a person has open on
// one job. Opened by the first punch on that job in that mode; every later segment on
// the same job and mode joins it, so switching away pauses it rather than closing
// it. Closed by the person with a resolution note, usually at the end of the day; an
// item left open carries a reason and shows up again the next day.
model WorkItem {
  id            String    @id @default(uuid())
  companyId     String
  personId      String
  jobId         String
  mode          String // service | shop | office | cad
  notes         String    @default("") // what it is about: the notes given when punching on it
  status        String    @default("open") // open | closed
  waitingReason String    @default("") // why it was left open at the end of a day
  resolution    String    @default("") // what was done, given when closing it
  openedAt      DateTime
  lastWorkedAt  DateTime
  closedAt      DateTime?
  closedById    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  person  Person  @relation(fields: [personId], references: [id])
  job     Job     @relation(fields: [jobId], references: [id])
  punches Punch[]

  @@index([personId, status])
  @@index([companyId, status])
  @@index([jobId])
}

// ─── Expenses ────────────────────────────────────────────────────────────────

// What an expense is for: Materials, Fuel, Meals, Parking, Mileage… kind "mileage"
// lines are entered as miles and priced at the company's mileage rate.
model ExpenseCategory {
  id          String  @id @default(uuid())
  companyId   String
  name        String
  kind        String  @default("expense") // expense | mileage
  accountCode String  @default("") // the accounting account it posts to
  sortOrder   Int     @default(0)
  active      Boolean @default(true)

  company  Company   @relation(fields: [companyId], references: [id])
  expenses Expense[]

  @@unique([companyId, name])
}

// One expense or mileage line. Charged to a job (the person's current flight, or
// one they pick) or to nothing (general overhead). Submitted when added; a manager
// or payroll approves or rejects it. Rejected lines can be fixed and go back in.
model Expense {
  id           String    @id @default(uuid())
  companyId    String
  personId     String
  jobId        String?
  punchId      String? // the segment that was the current flight when it was added
  date         String // YYYY-MM-DD, company time
  categoryId   String
  amountCents  Int // what is claimed; for mileage, miles × rate
  miles        Float?
  ratePerMile  Float?
  paidBy       String    @default("employee") // employee (reimburse) | company_card
  vendor       String    @default("")
  notes        String    @default("")
  receiptPath  String? // file under server/uploads/receipts
  receiptType  String?
  status       String    @default("submitted") // draft | submitted | approved | rejected
  submittedAt  DateTime?
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String    @default("")
  clientId     String? // generated on the phone; a re-send does not add it twice
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company  Company         @relation(fields: [companyId], references: [id])
  person   Person          @relation(fields: [personId], references: [id])
  job      Job?            @relation(fields: [jobId], references: [id])
  category ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@unique([companyId, clientId])
  @@index([companyId, status])
  @@index([personId, date])
  @@index([jobId])
}
