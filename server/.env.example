# Copy to .env and fill in. Never commit .env.

# PostgreSQL — its own database, separate from GED and Project Report
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/timetracking

PORT=5400

# Signs sign-in sessions. Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# One-click sign-in from GED. Must be the SAME value as ADDON_SSO_SECRET in GED's server/.env.
ADDON_SSO_SECRET=
# Create a tech account automatically the first time someone arrives from GED
SSO_AUTO_PROVISION=true

# "Sign in with Google". Use the same OAuth web client id as GED's GOOGLE_CLIENT_ID.
# In Google Cloud Console -> Credentials -> that client, add each address the app is
# opened from to "Authorized JavaScript origins", e.g. http://localhost:5195 and the
# HTTPS tunnel address. Google does not accept plain-http LAN addresses (10.x / 192.168.x).
GOOGLE_CLIENT_ID=
# People from this Google Workspace domain are added as techs on their first Google
# sign-in. Leave empty to allow only people already in the app.
GOOGLE_ALLOWED_DOMAIN=morgansound.com

# Used once by `npm run seed` to create the company and the first admin
COMPANY_NAME=Morgan Sound
COMPANY_TIMEZONE=America/Los_Angeles
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Shop location for the "punched at the shop" marker (optional)
SHOP_LAT=
SHOP_LNG=
SHOP_RADIUS_M=150

# Browser origins allowed to call the API directly (comma-separated). Leave blank when
# the server serves the app itself.
CORS_ORIGINS=http://localhost:5195

# Parallel run with Timesheets.com: through this date (YYYY-MM-DD) the app asks
# people to make every punch in Timesheets.com too, because payroll still runs
# from there. Clear it (or set a later date) at cutover.
PARALLEL_RUN_UNTIL=2026-12-31
TIMESHEETS_MIRROR_URL=https://secure.timesheets.com/

# Where people open this app (the page). "Sign in with Dashboard" returns to
# <APP_URL>/api/v1/auth/dashboard/callback.
APP_URL=http://localhost:5195

# Sign in with the Dashboard (GED is the sign-in service for every add-on).
# Written by GED: npm run oidc:client -- time_tracking ... --addon-env <this file>
DASHBOARD_ISSUER=
DASHBOARD_CLIENT_ID=time_tracking
DASHBOARD_CLIENT_SECRET=
